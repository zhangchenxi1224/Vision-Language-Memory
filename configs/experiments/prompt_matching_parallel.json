{
  "schema": "vision_memory.prompt_matching_parallel.v1",
  "status": "PROSPECTIVE_PROTOCOL_NOT_EXPERIMENTAL_EVIDENCE",
  "default_supervision": "hard_ce",
  "supervision_modes": ["hard_ce", "history_hard", "prompt_matching"],
  "format_arms": ["A", "B"],
  "training": {
    "teacher_steps": 288,
    "teacher_optimizer": "Adam",
    "teacher_lr": 0.05,
    "history_scope": "initial_exchange_only",
    "training_families": ["T1", "T2", "T3"],
    "temperature": 1.0,
    "writer_steps": 2048,
    "writer_effective_batch": 4,
    "writer_optimizer": "AdamW",
    "writer_lr": 0.00005,
    "writer_clip_norm": 1.0,
    "retain_steps": 2048,
    "sample_steps": 28,
    "cfg_scale": 1.0,
    "png_roundtrip": true
  },
  "evaluation": {
    "families": ["T1", "T2", "T3", "O1", "O2"],
    "tasks": ["free", "mcq"],
    "controls": ["memory", "blank", "mismatch", "text"],
    "noise_chains": 2,
    "max_new_tokens": {"free": 300, "mcq": 32},
    "phases": {"initial": [0], "retention": [0, 5, 10]},
    "joint_families": ["O1", "O2"]
  },
  "comparison": {
    "unit": "preference_id",
    "primary_task": "free",
    "primary_prefix": 0,
    "bootstrap_samples": 10000,
    "bootstrap_seed": 20261005,
    "confidence": 0.95,
    "noninferiority_margin": 0.02,
    "promotion_requires_split": ["dev", "official"],
    "promotion_requires_endpoint": "student",
    "promotion_requires_phase": "retention",
    "automatic_default_switch": false
  },
  "disclosures": [
    "Equal update budgets do not imply equal FLOPs: soft distribution extraction adds work.",
    "O1/O2 are held-out wording, not new semantic tasks; no gradient or checkpoint selection uses them.",
    "The 0.02 guardrail is a prospective tolerance, not a threshold fitted to historical scores.",
    "Bootstrap intervals are marginal descriptive intervals; multiple comparisons and adaptive reuse require separate confirmation.",
    "Dev and official data have prior project exposure; they are held out from these training jobs, not claimed to be research-naive.",
    "A remote text judge is not evidence of transfer to a black-box image Reader."
  ]
}
