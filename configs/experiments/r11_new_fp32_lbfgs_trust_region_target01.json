    "history_size": 10,
    "curvature_pair": "s_k = x_k-x_(k-1), y_k = g_k-g_(k-1), formed only after an accepted previous update",
    "curvature_acceptance": "dot(s_k,y_k) > 1e-8*norm(s_k)*norm(y_k), with all scalar reductions in float64",
    "curvature_relative_threshold": 1e-8,
    "history_order": "retain the newest 10 accepted curvature pairs in chronological order",
    "two_loop_first_pass": "newest to oldest: alpha_i=rho_i*dot(s_i,q), q=q-alpha_i*y_i",
    "initial_inverse_hessian_scale": "gamma=dot(s_last,y_last)/dot(y_last,y_last); gamma=1 when history is empty",
    "two_loop_second_pass": "oldest to newest: beta_i=rho_i*dot(y_i,r), r=r+s_i*(alpha_i-beta_i)",
    "two_loop_vector_arithmetic": "q and r use CPU float64; raw direction is cast once to float32 before unit-L2 normalization",
    "two_loop_numeric_contract": "q, r, s and y vector arithmetic and every dot product are evaluated in float64 on CPU; the resulting raw direction is cast once to float32 before deterministic unit normalization",
    "raw_direction": "p_k=-r; p_0=-g_0 because history is empty",
    "descent_restart": "if p_k is nonfinite or dot(g_k,p_k)>=0, clear all history and use p_k=-g_k",
